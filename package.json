{
  "name": "dsh-ui-background",
  "version": "0.1.0",
  "description": "Web GUI appearance plugin for dsh: background image, transparent background, and background opacity, with a settings row in the General section",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Junt184/dsh-ui-background.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "background",
    "theme"
  ],
  "license": "MIT"
}
